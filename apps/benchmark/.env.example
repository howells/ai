# Required server-only benchmark policy. Use independent random values for each secret.
DATABASE_URL=postgresql://user:password@host/database
BENCHMARK_SHARED_SECRET=
BENCHMARK_SESSION_PEPPER=
BENCHMARK_HASH_SECRET=
BENCHMARK_CANONICAL_ORIGIN=http://localhost:23010

# Configure at least one provider route. Ollama is available only when explicit.
AI_GATEWAY_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# Optional conservative defaults.
# BENCHMARK_DAILY_ATTEMPT_LIMIT=500
# BENCHMARK_RUN_ATTEMPT_LIMIT=50
# BENCHMARK_ACTIVE_RUN_LIMIT=2
# BENCHMARK_SESSION_TTL_SECONDS=28800
# BENCHMARK_HASH_KEY_VERSION=1
