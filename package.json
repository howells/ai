{
  "name": "@howells/ai",
  "version": "1.1.0",
  "description": "The best model for each job: one OpenRouter model ID per kind of work, with the request settings measured alongside it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howells/ai.git"
  },
  "bin": {
    "howells-ai": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./bench": {
      "types": "./dist/bench.d.mts",
      "import": "./dist/bench.mjs",
      "default": "./dist/bench.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "howells-check src test tsdown.config.ts oxlint.config.ts oxfmt.config.ts",
    "lint:fix": "howells-fix src test tsdown.config.ts oxlint.config.ts oxfmt.config.ts",
    "lint:ratchet": "howells-ratchet",
    "lint:rebaseline": "howells-ratchet --write",
    "prepack": "pnpm build",
    "prepare": "howells-husky",
    "prepush": "pnpm typecheck && pnpm lint:ratchet && pnpm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@howells/envy": "^0.3.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@howells/husky": "^0.2.5",
    "@howells/lint": "^3.5.1",
    "@types/node": "^26.0.1",
    "lint-staged": "^17.5.1",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc,css,md,mdx}": "howells-oxfmt --write"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.5.2"
}
